<?xml version="1.0" encoding="utf-8"?>
<robot name="ur5e">
  <!-- PLANNING GROUPS -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="hande_tcp_link"/>
  </group>

  <group name="gripper">
    <link name="hande_base_link"/>
    <link name="hande_jaw1_link"/>
    <link name="hande_jaw2_link"/>
    <link name="hande_finger1"/>
    <link name="hande_finger2"/>
    <joint name="hande_joint"/>
    <joint name="hande_base_to_hande_jaw2_link"/>
  </group>

  <!-- NAMED GROUP STATES -->
  <group_state group="ur_manipulator" name="home_vertical">
    <joint name="shoulder_pan_joint" value="0.335"/>
    <joint name="shoulder_lift_joint" value="0.771"/>
    <joint name="elbow_joint" value="-2.282"/>
    <joint name="wrist_1_joint" value="-0.377"/>
    <joint name="wrist_2_joint" value="2.302"/>
    <joint name="wrist_3_joint" value="1.113"/>
  </group_state>

  <group_state group="gripper" name="open">
    <joint name="hande_joint" value="0.012"/>
    <joint name="hande_base_to_hande_jaw2_link" value="0.012"/>
  </group_state>

  <group_state group="gripper" name="closed">
    <joint name="hande_joint" value="-0.002"/>
    <joint name="hande_base_to_hande_jaw2_link" value="-0.002"/>
  </group_state>

  <!-- END EFFECTOR -->
  <end_effector name="hande_gripper" parent_link="hande_tcp_link" group="gripper" parent_group="ur_manipulator"/>

  <!-- DISABLE COLLISIONS (Self-Collision Matrix) -->
  <disable_collisions link1="table" link2="wall_link" reason="Adjacent"/>
  <disable_collisions link1="table" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="table" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="wall_link" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="wall_link" link2="shoulder_link" reason="Never"/>

  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_link_inertia" link2="wrist_1_link" reason="Never"/>

  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_2_link" reason="Never"/>

  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>

  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_camera_mount_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_base_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_jaw1_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="hande_camera_mount_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_base_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_jaw1_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="wrist_3_link" link2="hande_camera_mount_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="hande_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="hande_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="hande_jaw1_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="hande_camera_mount_link" link2="hande_camera_link" reason="Adjacent"/>
  <disable_collisions link1="hande_camera_mount_link" link2="hande_base_link" reason="Adjacent"/>
  <disable_collisions link1="hande_camera_mount_link" link2="hande_jaw1_link" reason="Never"/>
  <disable_collisions link1="hande_camera_mount_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="hande_camera_mount_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="hande_camera_mount_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="hande_camera_link" link2="hande_base_link" reason="Never"/>
  <disable_collisions link1="hande_camera_link" link2="hande_jaw1_link" reason="Never"/>
  <disable_collisions link1="hande_camera_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="hande_camera_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="hande_camera_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="hande_base_link" link2="hande_jaw1_link" reason="Adjacent"/>
  <disable_collisions link1="hande_base_link" link2="hande_jaw2_link" reason="Adjacent"/>
  <disable_collisions link1="hande_base_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="hande_base_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="hande_jaw1_link" link2="hande_jaw2_link" reason="Never"/>
  <disable_collisions link1="hande_jaw1_link" link2="hande_finger1" reason="Adjacent"/>
  <disable_collisions link1="hande_jaw1_link" link2="hande_finger2" reason="Never"/>

  <disable_collisions link1="hande_jaw2_link" link2="hande_finger1" reason="Never"/>
  <disable_collisions link1="hande_jaw2_link" link2="hande_finger2" reason="Adjacent"/>

  <disable_collisions link1="hande_finger1" link2="hande_finger2" reason="Never"/>
</robot>
